# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
API_PUBLIC_URL=http://localhost:3333
EXTERNAL_STORE_URL=https://vkudaka.com.br          # RN-01: destino do não assinante
PUBLIC_WEB_URL=https://vkudaka.vercel.app          # retorno do link de pagamento do plano
CLUB_WHATSAPP_URL=https://wa.me/55XXXXXXXXXXX
CLUB_INSTAGRAM_URL=https://instagram.com/vkudaka

# ─── Banco ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vkudaka:vkudaka@localhost:5435/vkudaka?schema=public
# Conexão direta p/ migrações. Em dev é igual à DATABASE_URL.
DIRECT_URL=postgresql://vkudaka:vkudaka@localhost:5435/vkudaka?schema=public

# ─── Segurança ────────────────────────────────────────────────────────────────
JWT_SECRET=troque-em-producao-minimo-32-caracteres-aqui
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
TICKET_HMAC_SECRET=troque-em-producao-assinatura-do-qrcode

# ─── Gateway de pagamento (Pix / cartão) ──────────────────────────────────────
# `crm` (padrão): a diretoria cola as credenciais do Mercado Pago na tela
# CRM › Pagamentos e nada abaixo precisa ser preenchido. Os demais valores
# mantêm o caminho por ambiente. `mock` só existe em desenvolvimento.
PAYMENT_PROVIDER=crm                               # crm | mercadopago | pagarme | asaas | mock (só dev)
# Cifra os segredos salvos pelo CRM (na falta, deriva do JWT_SECRET).
SETTINGS_ENCRYPTION_KEY=
PAYMENT_API_KEY=
# Segredo do webhook. Sem ele não há como separar um aviso do gateway de um
# POST forjado dizendo que o pagamento foi aprovado.
PAYMENT_WEBHOOK_SECRET=
# RN-10 — conta recebedora. Só é lida quando PAYMENT_PROVIDER não é `crm`.
PAYMENT_RECIPIENT_NAME=
PAYMENT_RECIPIENT_DOCUMENT=
PAYMENT_RECIPIENT_BANK=
PAYMENT_RECIPIENT_AGENCY=
PAYMENT_RECIPIENT_ACCOUNT=
PAYMENT_RECIPIENT_PIX_KEY=

# ─── Correios ─────────────────────────────────────────────────────────────────
CORREIOS_PROVIDER=table                            # table (estimativa por CEP, serve em produção) | correios | melhorenvio | mock (só dev)
CORREIOS_USER=
CORREIOS_PASSWORD=
CORREIOS_ORIGIN_ZIP=01310100
LABEL_PROVIDER=none                                # none (sem etiqueta/declaração) | melhorenvio | nuvemshop | mock (só dev)

# ─── Push ─────────────────────────────────────────────────────────────────────
PUSH_PROVIDER=expo                                 # expo | fcm  (mock: só em dev)
EXPO_ACCESS_TOKEN=

# ─── Storage de mídia ─────────────────────────────────────────────────────────
STORAGE_PROVIDER=local                             # local | supabase (supabase em produção)
STORAGE_BUCKET=media
# Produção (Supabase). A service_role NUNCA vai ao app — só no servidor.
#   SUPABASE_URL=https://<ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=<service_role do projeto>
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
